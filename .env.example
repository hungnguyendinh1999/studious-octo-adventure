# Ollama (active backend — see src/modelClient.ts:OllamaModelClient)
# Base URL for Ollama's OpenAI-compatible endpoint. Optional — defaults to
# http://localhost:11434/v1 if unset.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Required. Set to a model you've already pulled, e.g. `ollama pull llama3.1`.
OLLAMA_MODEL=

# Optional. Feeds a client-side pre-flight token estimate/warning only —
# it cannot actually change Ollama's real context window (that's set
# server-side via a Modelfile's `PARAMETER num_ctx` or the server's
# OLLAMA_CONTEXT_LENGTH env var). Defaults to 4096 if unset.
# OLLAMA_CONTEXT_WINDOW=4096

# Anthropic (inactive backend — kept for AnthropicModelClient in
# src/modelClient.ts). Not required while running on Ollama; only needed
# if cli.ts is switched back to AnthropicModelClient.
ANTHROPIC_API_KEY=
